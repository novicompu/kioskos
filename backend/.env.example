# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portalpayjoy?schema=public"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-too

# Integracion externa Novisuite / Kiosko PayJoy
PAYJOY_API_BASE_URL=https://novisuite-api.novisolutions.co
PAYJOY_SERVICE_KEY=TU_TOKEN

# SMTP (opcional): usado para recuperacion de contraseña e invitaciones
# de superadmin. Si se deja vacio, el correo se loguea en consola en vez
# de enviarse de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kiosko <no-reply@tudominio.com>"
# Poner en "false" solo si el proveedor SMTP lo exige (certificado no
# verificable / self-signed). Por defecto se valida (mas seguro).
SMTP_REJECT_UNAUTHORIZED=true
